FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       polyBoundaryMesh;
    location    "constant/polyMesh";
    object      boundary;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

4
(
    left
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          10;
        startFace       180;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  right;
    }
    right
    {
        type            cyclic;
        inGroups        1(cyclic);
        nFaces          10;
        startFace       190;
        matchTolerance  0.0001;
        transform       unknown;
        neighbourPatch  left;
    }
    walls
    {
        type            wall;
        inGroups        1(wall);
        nFaces          20;
        startFace       200;
    }
    frontAndBack
    {
        type            empty;
        inGroups        1(empty);
        nFaces          200;
        startFace       220;
    }
)

